# Copy to .env and fill in real values. Never commit .env.

# Portkey API key for the agent's OpenAI calls (Problem 5+)
PORTKEY_API_KEY=your-portkey-api-key-here

# Long random string used to sign login session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: which OpenAI model the shop agent uses through Portkey (default gpt-5.6-luna)
# CAMPUS_MODEL=gpt-5.6-luna

# Optional: set to 0 to skip the ~179 MB photo clean-up model and use the simple clean-up
# CAMPUS_IMAGE_AI=0

# Optional: where the data pack lives, if not in hw4/data
# CAMPUS_DATA_DIR=/path/to/data

# Optional: HTTPS-only login cookies when deployed
# COOKIE_SECURE=true
